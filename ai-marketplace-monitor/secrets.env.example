# Copy to ~/.ai-marketplace-monitor/secrets.env and fill in:
#   mkdir -p ~/.ai-marketplace-monitor
#   cp secrets.env.example ~/.ai-marketplace-monitor/secrets.env
#   chmod 600 ~/.ai-marketplace-monitor/secrets.env
#
# Read by run.sh and exported into the process environment; config.toml
# references these as ${VAR}. Never commit the filled-in file.

FACEBOOK_USERNAME=""
FACEBOOK_PASSWORD=""

# Free key, no card, ~1000 req/day: https://console.groq.com/keys
GROQ_API_KEY=""

# Second free tier with its OWN ~1000 req/day, separate from Groq's. Groq's
# budget is shared between listing evaluation and device-spec lookups, so when
# it runs dry both stop. https://cloud.cerebras.ai
CEREBRAS_API_KEY=""

# Free key: https://aistudio.google.com/apikey  (fallback providers)
GEMINI_API_KEY=""

# Any hard-to-guess string. Subscribe to the same topic in the ntfy app.
NTFY_TOPIC=""
