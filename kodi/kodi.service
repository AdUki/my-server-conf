[Unit]
Description=Kodi Media Center
After=multi-user.target sound.target network.target
Wants=network.target

[Service]
User=pi
Group=audio
Type=simple
# ~/.kodi/temp is a symlink into tmpfs (see setup.sh install_kodi).
ExecStartPre=/bin/mkdir -p /tmp/kodi-temp
ExecStart=/usr/bin/kodi-standalone
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
